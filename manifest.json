{
  "manifest_version": 3,
  "name": "Modus",
  "version": "3.9.6",
  "description": "Typing lag fix, bulk sidebar management, model badge, context awareness, inline chat rename, and export.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/modus-16x16.png",
    "32": "assets/modus-32x32.png",
    "48": "assets/modus-48x48.png",
    "128": "assets/modus-128x128.png",
    "512": "assets/modus-512x512.png"
  },
  "action": {
    "default_title": "Modus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/modus-16x16.png",
      "32": "assets/modus-32x32.png",
      "48": "assets/modus-48x48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "net-sniffer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "111"
}
